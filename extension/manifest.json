{
  "manifest_version": 3,
  "name": "Listing Check",
  "version": "0.1.0",
  "description": "Checks a listing's address against Microburbs data: estimate, basics, nearby sales, rent and DAs. City of Sydney only.",
  "action": {
    "default_title": "Listing Check"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.realestate.com.au/*",
        "https://www.domain.com.au/*"
      ],
      "js": [
        "src/extract.js",
        "panel/score.js",
        "panel/meter.js",
        "panel/halos.js",
        "panel/profile.js",
        "src/panel.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "http://localhost:8787/*",
    "http://127.0.0.1:8787/*",
    "https://*.vercel.app/*"
  ]
}
