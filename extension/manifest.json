{
  "manifest_version": 3,
  "name": "MicroMatch",
  "version": "0.2.0",
  "description": "See how well a City of Sydney listing fits your commute, safety, lifestyle and budget. Reads only the address.",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open MicroMatch"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.realestate.com.au/*",
        "https://www.domain.com.au/*"
      ],
      "js": [
        "src/extract.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
