# Copy to proxy/.env (gitignored) and paste the team key. Never commit the real key.
MICROBURBS_API_KEY=paste-your-team-key-here
# The proxy listens on 3000, the port the extension calls.
# PORT=3000
# Optional paths to the supplied local files (never commit the files).
# MICROBURBS_ADDRESSES_CSV=../data/addresses-city-of-sydney.csv
# MICROBURBS_SOCIAL_HOUSING_CSV=../data/public-housing-homes-city-of-sydney.csv
